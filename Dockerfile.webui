FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app
COPY requirements.txt /tmp/core-requirements.txt
COPY webui/requirements.txt /tmp/webui-requirements.txt
RUN python -m pip install --upgrade pip \
    && pip install -r /tmp/core-requirements.txt -r /tmp/webui-requirements.txt

COPY model ./model
COPY webui ./webui

WORKDIR /app/webui
EXPOSE 7070
CMD ["python", "app.py"]
