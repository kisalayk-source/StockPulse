# Same-origin path proxied by Vite to the FastAPI backend.
# Works on localhost and other devices on the LAN.
VITE_API_BASE_URL=/api/v1

# Set this when the backend API_KEY is configured. Never commit a real key.
VITE_API_KEY=

# Development server only. The backend must also enable its guarded development bypass.
VITE_DEV_AUTH_BYPASS=false
